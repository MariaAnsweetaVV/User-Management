<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit User</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">

</head>


<body>

  <div class="home-subadmin">

    <nav class="navbar navbar-expand-lg nabar-light fixed-top">
      <div class="container-fluid">
        <div class="navbar-brand" style="font-weight: 500;">
          Sub Admin Dashboard
        </div>


        <form action="/logout" method="POST">

          <button type="submit" class="btn btn-danger">
            Logout
          </button>

        </form>
      </div>
    </nav>

    <div class="container mt-5">

      <div class="card">

        <div class="card-header">

          <h3>
            Edit User
          </h3>

        </div>


        <div class="card-body">

          <form action="/subadmin/edit/<%= user._id %>" method="POST">

            <!-- Username -->

            <div class="mb-3">

              <label class="form-label">
                Username
              </label>

              <input type="text" name="username" value="<%= user.name %>" class="form-control" required>

            </div>


            <!-- Role -->

            <div class="mb-3">

              <label class="form-label">
                Role
              </label>

              <input type="text" class="form-control" value="user" disabled>

            </div>

            <div>
              <% if (error) { %>

                <div class="text-danger mb-1">
                  <%= error %>
                </div>

                <% } %>
            </div>

            <!-- Buttons -->

            <button type="submit" class="btn btn-primary">
              Update User
            </button>


            <a href="/subadmin" class="btn btn-secondary">
              Cancel
            </a>

          </form>

        </div>

      </div>

    </div>
  </div>
</body>

</html>