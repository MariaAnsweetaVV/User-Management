<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Subadmin Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">

</head>

<body>

  <div class="home-subadmin">

    <nav class="navbar navbar-expand-lg nabar-light fixed-top">
      <div class="container-fluid">
        <div class="navbar-brand" style="font-weight: 500;">
          <b>SubAdmin Dashboard</b>
        </div>


        <form action="/logout" method="POST">

          <button type="submit" class="btn btn-danger">
            Logout
          </button>

        </form>
      </div>
    </nav>

    <div class="container mt-5">

      <!-- ================================= -->
      <!-- ADD USER -->
      <!-- ================================= -->

      <div class="card mb-4">

        <div class="card-header">
          <h4 class="mb-0">
            Add User
          </h4>
        </div>


        <div class="card-body">

          <form action="/subadmin/add-user" method="POST">

            <div class="mb-3">

              <label class="form-label">
                Username
              </label>

              <input type="text" name="username" class="form-control" placeholder="Enter username" required>

            </div>


            <div class="mb-3">

              <label class="form-label">
                Password
              </label>

              <input type="password" name="password" class="form-control" placeholder="Enter password" required>

            </div>


            <button type="submit" class="btn btn-primary">
              Add User
            </button>

          </form>

        </div>

      </div>


      <!-- ================================= -->
      <!-- USER LIST -->
      <!-- ================================= -->

      <div class="card">

        <div class="card-header">

          <h4 class="mb-0">
            Users
          </h4>

        </div>


        <div class="card-body">

          <% if (users.length===0) { %>

            <p class="text-muted">
              No users found.
            </p>

            <% } else { %>

              <div class="table-responsive">

                <table class="table table-bordered table-hover">

                  <thead>

                    <tr>

                      <th>
                        Sl.No
                      </th>

                      <th>
                        Username
                      </th>

                      <th>
                        Role
                      </th>

                      <th>
                        Actions
                      </th>

                    </tr>

                  </thead>


                  <tbody>

                    <% users.forEach((user, index)=> { %>

                      <tr>

                        <td>
                          <%= index + 1 %>
                        </td>

                        <td>
                          <%= user.name %>
                        </td>

                        <td>

                          <span class="badge bg-secondary">
                            <%= user.role %>
                          </span>

                        </td>

                        <td>

                          <!-- Edit will be added next -->

                          <a href="/subadmin/edit/<%= user._id %>" class="btn btn-warning btn-sm">
                            Edit
                          </a>


                          <!-- Subadmin cannot delete -->

                          <!-- <button class="btn btn-danger btn-sm" disabled>
                          Delete
                        </button> -->

                        </td>

                      </tr>

                      <% }) %>

                  </tbody>

                </table>

              </div>

              <% } %>

        </div>

      </div>

    </div>
  </div>
</body>

</html>