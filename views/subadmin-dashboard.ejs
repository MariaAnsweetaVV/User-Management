<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sub Admin Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.css">

  <link rel="stylesheet" href="/style.css">

</head>

<body>

  <div class="home-subadmin">

    <div class="header pt-3 ps-5 pe-5 bg-dark d-flex justify-content-between align-items-center">
      <div class="navbar-brand">
        Sub Admin Dashboard
      </div>


      <form action="/logout" method="POST">

        <button type="submit" class="btn btn-danger">
          Logout
        </button>

      </form>
    </div>

    <div class="container" style="padding-top: 250px;">

      <% if (permissions.createUser) { %>

        <!-- ADD USER -->

        <div class="card mb-4" style="padding-top: 250px;">

          <div class="card-header">
            <h4 class="mb-0">
              Add User
            </h4>
          </div>


          <div class="card-body">

            <form action="/subadmin/add-user" method="POST">

              <div class="mb-3">

                <label class="form-label">
                  Username
                </label>

                <input type="text" name="username" class="form-control" placeholder="Enter username" required>

              </div>


              <div class="mb-3">

                <label class="form-label">
                  Password
                </label>

                <input type="password" name="password" class="form-control" placeholder="Enter password" required>

              </div>

              <div>
                <% if (error) { %>

                  <div class="text-danger mb-1">
                    <%= error %>
                  </div>

                  <% } %>
              </div>

              <button type="submit" class="btn btn-primary">
                Add User
              </button>

            </form>

          </div>

        </div>
        <% } %>

          <!-- USER LIST -->

          <div class="card">

            <div class="card-header">

              <h4 class="mb-0">
                Users
              </h4>

            </div>


            <div class="card-body">

              <% if (users.length===0) { %>

                <p class="text-muted">
                  No users found.
                </p>

                <% } else { %>

                  <div class="table-responsive">

                    <table id="userTable" class="table table-bordered table-hover">

                      <thead class="table-dark">

                        <tr>

                          <th class="text-center">
                            Sl.No
                          </th>

                          <th class="text-center">
                            Username
                          </th>

                          <th class="text-center">
                            Role
                          </th>

                          <th class="text-center">
                            Actions
                          </th>

                        </tr>

                      </thead>


                      <tbody>

                        <% users.forEach((user, index)=> { %>

                          <tr>

                            <td class="text-center">
                              <%= index + 1 %>
                            </td>

                            <td class="text-center">
                              <%= user.name %>
                            </td>

                            <td>

                              <span class="badge bg-secondary">
                                <%= user.role %>
                              </span>

                            </td>

                            <td>

                              <!-- Edit will be added next -->

                              <a href="/subadmin/edit/<%= user._id %>" class="btn btn-warning btn-sm">
                                Edit
                              </a>

                            </td>

                          </tr>

                          <% }) %>

                      </tbody>

                    </table>

                  </div>

                  <% } %>

            </div>

          </div>

    </div>
  </div>


  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <script src="https://cdn.datatables.net/2.3.3/js/dataTables.js"></script>

  <script>
    $(document).ready(function () {
      $('#userTable').DataTable({
        scrollY: '500px'
      });
    });
  </script>

</body>

</html>