<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Admin Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.css">

  <link rel="stylesheet" href="/style.css">

</head>

<body>

  <div class="home-admin">


    <div class="header pt-3 ps-5 pe-5 bg-dark">
      <div class="navbar-brand">
        Admin Dashboard
      </div>


      <form action="/logout" method="POST">

        <button type="submit" class="btn btn-danger">
          Logout
        </button>

      </form>
    </div>



    <!-- MAIN CONTENT -->

    <div class="container" style="margin-top: 150px;">

      <div class="d-flex justify-content-between align-items-center">

        <!-- USER TABLE -->

        <h4 class=" mt-5 mb-3">
          All Users
        </h4>
        <div>
          <a href="/admin/add-user" class="btn btn-primary  mt-5 mb-3">
            <b>+</b> Add
          </a>
        </div>
      </div>

      <div class="table-responsive">

        <table id="userTable" class="table table-bordered table-hover">

          <thead class="table-dark">

            <tr>

              <th class="text-center">Sl.No</th>

              <th class="text-center">Username</th>

              <th class="text-center">Role</th>

              <th class="text-center">Permissions</th>

              <th class="text-center">Actions</th>

            </tr>

          </thead>


          <tbody>

            <% let index=1; %>

              <% users.forEach((user)=> { %>

                <% if (user.role !=="admin" ) { %>
                  <tr>

                    <td class="text-center">
                      <%= index++ %>
                    </td>


                    <td class="text-center">
                      <%= user.name %>
                    </td>


                    <td class="text-center">

                      <% if (user.role==="admin" ) { %>

                        <span class="badge bg-danger">
                          Admin
                        </span>

                        <% } else if (user.role==="subadmin" ) { %>

                          <span class="badge bg-warning text-dark">
                            Subadmin
                          </span>

                          <% } else { %>

                            <span class="badge bg-primary">
                              User
                            </span>

                            <% } %>

                    </td>


                    <td>

                      <% if (user.permissions) { %>

                        <% if (user.permissions.createUser) { %>
                          <span class="badge bg-success">
                            Create
                          </span>
                          <% } %>

                            <% if (user.permissions.editUser) { %>
                              <span class="badge bg-info">
                                Edit
                              </span>
                              <% } %>

                                <% if (user.permissions.deleteUser) { %>
                                  <span class="badge bg-danger">
                                    Delete
                                  </span>
                                  <% } %>

                                    <% if (user.permissions.viewUser) { %>
                                      <span class="badge bg-secondary">
                                        View
                                      </span>
                                      <% } %>

                                        <% } %>

                    </td>


                    <td>

                      <% if (user.role !=="admin" ) { %>

                        <!-- EDIT -->
                        <a href="/admin/edit/<%= user._id %>" class="btn btn-warning btn-sm">
                          Edit
                        </a>

                        <!-- DELETE -->
                        <form action="/admin/delete/<%= user._id %>" method="POST" style="display:inline;"
                          onsubmit="return confirm('Are you sure you want to delete this user?');">

                          <button type="submit" class="btn btn-danger btn-sm">
                            Delete
                          </button>

                        </form>

                        <!-- PERMISSIONS - ONLY SUBADMIN -->
                        <% if (user.role==="subadmin" ) { %>

                          <a href="/admin/permissions/<%= user._id %>" class="btn btn-primary btn-sm">
                            Permissions
                          </a>

                          <% } %>

                            <% } else { %>

                              <span class="text-muted">
                                Admin account
                              </span>

                              <% } %>

                    </td>
                  </tr>
                  <% } %>
                    <% }) %>

          </tbody>

        </table>

      </div>

    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <script src="https://cdn.datatables.net/2.3.3/js/dataTables.js"></script>

  <script>
    $(document).ready(function () {
      $('#userTable').DataTable({
        scrollY: '500px'
      });
    });
  </script>

</body>

</html>